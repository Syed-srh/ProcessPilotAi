# Server Environment Variables Template (ProcessPilot AI)

PORT=5000
NODE_ENV=production

# Database (Supabase / Neon Postgres Free Tier)
# Example: postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT Authentication (Min 32 characters random secret string)
JWT_SECRET="super-secret-jwt-key-min-32-characters-long"
JWT_EXPIRES_IN="7d"

# Frontend Client URL (For CORS & Socket.IO Security)
CLIENT_URL="https://processpilot-ai.vercel.app"

# AI Providers (Free Tier Keys)
# Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="AIzaSy..."

# GroqCloud Console: https://console.groq.com/
GROQ_API_KEY="gsk_..."
